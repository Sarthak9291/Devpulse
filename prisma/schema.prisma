generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  githubId String? @unique
  githubUsername String?
  githubAccessToken String?

  memberships OrganizationMember[]
  refreshTokens RefreshToken[]
}

model Organization {
  id        Int      @id @default(autoincrement())
  name      String
  inviteCode String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repositories Repository[]
  memberships  OrganizationMember[]
}

model Repository {
  id        Int      @id @default(autoincrement())
  name      String   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId Int
  organization   Organization @relation(fields: [organizationId],references: [id])

  githubRepoId   String?  @unique
  githubRepoName String?
  githubRepoUrl  String?
  WebhookEvents WebhookEvent[]
  repositoryMatrics RepositoryMetrics[]
  activities Activity[]
  pullRequestAnalytics PullRequestAnalytics[]
  deploymentAnalytics DeploymentAnalytics[]
  @@unique([organizationId, name])
}

model OrganizationMember {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  userId         Int
  organizationId Int

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model WebhookEvent {
  id Int @id @default(autoincrement())

  repositoryId Int
  repository Repository @relation(fields: [repositoryId],references: [id])

  eventType String
  action String?
  sender String?

  payload Json

  receivedAt DateTime @default(now())
}

model Activity {
  id           Int      @id @default(autoincrement())

  repositoryId Int
  repository   Repository @relation(fields:[repositoryId], references:[id])

  eventType    String

  title        String
  description  String?
  metadata Json?

  createdAt    DateTime @default(now())
}

model RepositoryMetrics {
  id            Int @id @default(autoincrement())

  repositoryId  Int @unique
  repository    Repository @relation(fields: [repositoryId], references: [id])

  pushCount     Int @default(0)

  prOpenedCount Int @default(0)
  prMergedCount Int @default(0)

  issueOpenedCount Int @default(0)
  issueClosedCount Int @default(0)
  
  totalBuilds Int @default(0)
  successfulBuilds Int @default(0)
  failedBuilds Int @default(0)

  deploymentCount       Int @default(0)
  successfulDeployments Int @default(0)
  failedDeployments     Int @default(0)
  releaseCount          Int @default(0)

  updatedAt DateTime @updatedAt
}

model PullRequestAnalytics {
  id             Int        @id @default(autoincrement())
  repositoryId   Int
  repository     Repository @relation(fields: [repositoryId], references: [id])
  githubPrId     String     @unique
  openedAt       DateTime
  mergedAt       DateTime?
  firstReviewedAt DateTime?
  reviewDuration Int?
  createdAt      DateTime   @default(now())
}

model DeploymentAnalytics {
  id                 Int        @id @default(autoincrement())
  repositoryId       Int
  repository         Repository @relation(fields: [repositoryId], references: [id])
  githubDeploymentId String     @unique
  environment        String?
  status             String
  createdAt          DateTime   @default(now())
}